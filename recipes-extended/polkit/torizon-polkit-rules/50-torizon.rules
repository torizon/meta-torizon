// Restore NetworkManager operations that were unrestricted before polkit
// joined DISTRO_FEATURES. NetworkManager picks its PACKAGECONFIG from
// DISTRO_FEATURES, so it used to be built -Dpolkit=false, which makes it
// authorize every operation for any non-root uid. It now enforces the
// upstream permission matrix instead.
//
// Administrative sessions reach the device over SSH or the serial console,
// and neither holds a seat, so polkit classifies them under allow_any --
// not allow_inactive, and never allow_active. Both permissive branches of
// the upstream defaults are therefore unreachable on those paths.
//
// Scope is deliberately narrow: five actions used by the default workflow,
// plus WWAN control because this layer enables ModemManager/PPP support.
// Every NetworkManager action was unrestricted before, so hotspot toggling,
// statistics, connectivity check, and sleep-wake still need root.
//
// The grant is also narrower than the old behaviour in a second way, on
// purpose: it is keyed on the "torizon" group, so a user outside that group,
// or a container that mounts the system bus and runs at a different uid, is
// denied where it previously was not.
//
// Customers can override this policy by installing a rule that sorts before
// this file in /etc/polkit-1/rules.d/, for example 40-customer.rules.
// A file named 50-torizon.rules in /etc also takes precedence over the file
// with the same name in /usr.
//
// Must stay ES5.1 -- duktape is not a modern engine. No arrow functions,
// no let/const, no template literals, no Array.prototype.includes.

polkit.addRule(function(action, subject) {
    if (!subject.isInGroup("torizon")) {
        return polkit.Result.NOT_HANDLED;
    }

    // wifi.scan is in the list because scanning is discovery rather than
    // configuration, and was unrestricted before polkitd. Without it
    // "nmcli device wifi rescan" fails with "not authorized".
    var allowed = [
        "org.freedesktop.NetworkManager.enable-disable-wifi",
        "org.freedesktop.NetworkManager.enable-disable-network",
        "org.freedesktop.NetworkManager.network-control",
        "org.freedesktop.NetworkManager.settings.modify.system",
        "org.freedesktop.NetworkManager.wifi.scan",
        "org.freedesktop.NetworkManager.enable-disable-wwan"
    ];

    if (allowed.indexOf(action.id) >= 0) {
        return polkit.Result.YES;
    }

    return polkit.Result.NOT_HANDLED;
});
